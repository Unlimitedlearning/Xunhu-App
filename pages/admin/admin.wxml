<!--pages/admin/admin.wxml
     管理后台（v1.7.0 统一审核流）：三个 Tab —— 内容审核 / 学号申诉 / 系统公告。
     所有数据都来自 admin 云函数（posts、reports、users 对客户端禁读），页面本身不发任何数据库查询。-->
<view class="admin">

  <!-- 顶部 Tab：与大厅同一套视觉，切换只做内存切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === item.key ? 'tab-item-active' : ''}}"
          wx:for="{{tabs}}"
          wx:for-item="item"
          wx:key="key"
          data-tab="{{item.key}}"
          bindtap="onTabChange">{{item.text}}</view>
  </view>

  <!-- ============ Tab 1：内容审核（唯一待办队列） ============ -->
  <scroll-view class="scrollarea" scroll-y wx:if="{{activeTab === 'audit'}}">
    <view class="container">

      <view class="hint">首帖、有违规记录、被用户举报的帖子都会进这里，不处理就一直停在「审核中」，大厅看不到。卡片顶部的标签说明进审原因；点标题可预览全文，再决定通过还是下架——下架必须选一个原因，系统会通知作者。</view>

      <view class="loading-text" wx:if="{{auditLoading && !auditLoaded}}">正在加载审核队列…</view>

      <view class="error-card" wx:if="{{auditError}}">{{auditError}}</view>

      <view class="empty-card" wx:if="{{auditLoaded && !auditError && auditPosts.length === 0}}">
        <view class="empty-emoji">🎉</view>
        <view class="empty-text">审核队列已清空</view>
      </view>

      <view class="report-card" wx:for="{{auditPosts}}" wx:key="postId">

        <!-- auditReason 标签：多条件同时命中会并排显示（被举报 / 违规用户发布 / 新用户首帖） -->
        <view class="audit-reason-row">
          <text class="audit-reason-tag tag-{{tag.type}}"
                wx:for="{{item.auditTags}}"
                wx:for-item="tag"
                wx:key="text">{{tag.text}}</text>
        </view>

        <view class="report-head">
          <view class="report-title-wrap"
                hover-class="report-title-hover"
                data-post-id="{{item.postId}}"
                bindtap="goPostDetail">
            <text class="report-title">{{item.title}}</text>
            <text class="report-title-link">预览帖子全文 ›</text>
          </view>
        </view>

        <!-- 正文直接铺开：审核看的就是内容本身，再点进详情反而多一步 -->
        <view class="audit-content">{{item.content}}</view>

        <view class="audit-tags" wx:if="{{item.tags.length}}">
          <text class="audit-tag"
                wx:for="{{item.tags}}"
                wx:for-item="tag"
                wx:key="*this">{{tag}}</text>
        </view>

        <view class="meta-row">
          <text class="meta-item">{{item.categoryText}}</text>
          <text class="meta-item" wx:if="{{item.reportCount}}">被举报 {{item.reportCount}} 次</text>
        </view>

        <view class="meta-row">
          <text class="meta-item">发帖人：{{item.authorName}}</text>
          <text class="meta-item" wx:if="{{item.authorCampus}}">校区：{{item.authorCampus}}</text>
        </view>

        <view class="meta-row">
          <text class="meta-item" wx:if="{{item.studentIdMasked}}">学号：{{item.studentIdMasked}}</text>
          <text class="meta-item">违规警告：{{item.warningCount}} 次</text>
        </view>

        <view class="report-desc" wx:if="{{item.latestReportReason}}">最新举报理由：{{item.latestReportReason}}</view>

        <view class="meta-row meta-row-last">
          <text class="meta-item meta-time">{{item.createTime}}</text>
        </view>

        <view class="action-row">
          <view class="btn btn-primary {{auditWorkingId ? 'btn-disabled' : ''}}"
                hover-class="btn-hover"
                data-post-id="{{item.postId}}"
                data-report-id="{{item.reportId}}"
                data-title="{{item.title}}"
                bindtap="onAuditApproveTap">通过</view>
          <view class="btn btn-danger {{auditWorkingId ? 'btn-disabled' : ''}}"
                hover-class="btn-hover"
                data-post-id="{{item.postId}}"
                data-report-id="{{item.reportId}}"
                data-title="{{item.title}}"
                bindtap="onAuditRejectTap">下架（选原因）</view>
        </view>

      </view>
    </view>
  </scroll-view>

  <!-- ============ Tab 2：学号申诉 ============ -->
  <scroll-view class="scrollarea" scroll-y wx:if="{{activeTab === 'appeal'}}">
    <view class="container">

      <view class="search-card">
        <input class="search-input"
               type="number"
               maxlength="10"
               placeholder="输入要查询的学号"
               value="{{studentIdInput}}"
               bindinput="onStudentIdInput"
               bindconfirm="onSearchTap" />
        <view class="search-btn" hover-class="btn-hover" bindtap="onSearchTap">搜索</view>
      </view>

      <view class="hint">后台不展示完整学号与任何联系方式。有同学申诉「学号被他人占用」时，在这里核对绑定者并强制解绑；解绑后该学号可被真正的同学重新绑定。</view>

      <view class="loading-text" wx:if="{{userLoading}}">正在查询…</view>

      <view class="error-card" wx:if="{{userError}}">{{userError}}</view>

      <view class="empty-card" wx:if="{{userSearched && !userLoading && !userError && users.length === 0}}">
        <view class="empty-emoji">🔍</view>
        <view class="empty-text">没有查到绑定该学号的账号</view>
      </view>

      <view class="user-card" wx:for="{{users}}" wx:key="openid">
        <view class="user-head">
          <text class="user-name">{{item.nickname}}</text>
          <text class="role-badge role-{{item.role}}">{{item.roleText}}</text>
        </view>

        <view class="meta-row"><text class="meta-item">学号：{{item.studentIdMasked}}</text></view>
        <view class="meta-row"><text class="meta-item">违规警告：{{item.warningCount}} 次（满 3 次自动封禁）</text></view>
        <view class="meta-row meta-row-last" wx:if="{{item.updateTime}}">
          <text class="meta-item meta-time">最近更新：{{item.updateTime}}</text>
        </view>

        <view class="action-row">
          <view class="btn btn-ghost"
                hover-class="btn-hover"
                wx:if="{{item.hasOpenid}}"
                data-openid="{{item.openid}}"
                bindtap="onWarningTap">记警告</view>
          <view class="btn btn-danger"
                hover-class="btn-hover"
                wx:if="{{item.hasOpenid && item.role !== 'banned'}}"
                data-openid="{{item.openid}}"
                bindtap="onBanTap">封禁</view>
          <view class="btn btn-ghost"
                hover-class="btn-hover"
                wx:if="{{item.hasOpenid}}"
                data-openid="{{item.openid}}"
                bindtap="onUnbindTap">强制解绑</view>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- ============ Tab 3：系统公告 ============ -->
  <scroll-view class="scrollarea" scroll-y wx:if="{{activeTab === 'announce'}}">
    <view class="container">

      <view class="hint">公告发布后会出现在所有用户的「消息中心」顶部（标题前带 📢），并让个人页亮红点。公告不会给每个人单独写一条通知，所以内容请一次说清。</view>

      <view class="form-card">
        <view class="form-label">公告标题<text class="form-required">*</text></view>
        <input class="form-input"
               placeholder="一句话说明，如「内测开始，欢迎反馈」"
               maxlength="{{announceTitleMax}}"
               value="{{announceTitle}}"
               bindinput="onAnnounceTitleInput" />
        <view class="form-counter">{{announceTitle.length}}/{{announceTitleMax}}</view>

        <view class="form-label form-label-gap">公告内容<text class="form-required">*</text></view>
        <textarea class="form-textarea"
                  placeholder="写清楚时间、范围、需要同学做什么"
                  maxlength="{{announceContentMax}}"
                  value="{{announceContent}}"
                  bindinput="onAnnounceContentInput"></textarea>
        <view class="form-counter">{{announceContent.length}}/{{announceContentMax}}</view>

        <view class="error-card" wx:if="{{announceError}}">{{announceError}}</view>

        <view class="btn btn-primary btn-block {{announceLoading ? 'btn-disabled' : ''}}"
              hover-class="btn-hover"
              bindtap="onPublishAnnouncementTap">{{announceLoading ? '发布中…' : '发布系统公告'}}</view>
      </view>

    </view>
  </scroll-view>

</view>
