/* pages/agreement/agreement.wxss */
page {
  background-color: #f5f6f8;
}

.doc-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.doc {
  padding: 32rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* 文首 */
.doc-head {
  padding: 8rpx 8rpx 24rpx;
}

.doc-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  line-height: 1.4;
}

.doc-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
}

.doc-intro {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
  padding: 32rpx;
  font-size: 28rpx;
  color: var(--color-title, #1A1A1A);
  line-height: 1.75;
  margin-bottom: 24rpx;
}

/* 章节 */
.section {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.para {
  font-size: 28rpx;
  color: var(--color-title, #1A1A1A);
  line-height: 1.75;
  margin-top: 8rpx;
  word-break: break-all;
}

/* 禁止行为清单 */
.list {
  margin: 8rpx 0;
}

.list-item {
  position: relative;
  padding-left: 28rpx;
  font-size: 28rpx;
  color: var(--color-title, #1A1A1A);
  line-height: 1.75;
  word-break: break-all;
}

.list-item::before {
  content: "·";
  position: absolute;
  left: 8rpx;
  color: var(--color-sub, #8A8A8A);
}

.doc-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
  padding: 24rpx 16rpx 0;
  line-height: 1.6;
}
