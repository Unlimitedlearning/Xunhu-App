/* pages/detail/detail.wxss */
page {
  background-color: #f5f6f8;
}

.detail-container {
  padding: 24rpx;
  /* 底部操作栏是 position:fixed，会盖住页面最后一块内容：
     88rpx 按钮 + 上下 20rpx 内边距 + 手机底部安全区，再多留一点余量，
     保证评价卡片最后一行能完整滑出来、不被按钮盖住 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

/* 卡片 */
.detail-card {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
}

/* 顶部：分类标签 + 状态标识 */
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 分类标签：防挤压 */
.category-tag {
  font-size: 26rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.4;
}
.category-team {
  background-color: #e6f0ff;
  color: #1e88e5;
}
.category-resume {
  background-color: #e8f8ec;
  color: #07c160;
}
.category-partner {
  background-color: #fff3e0;
  color: #fb8c00;
}
.category-other {
  background-color: #f0f0f0;
  color: #999999;
}

/* 状态标识：防挤压 */
.status-badge {
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.status-draft {
  color: #e53935;
  background-color: #ffebee;
}
.status-auditing {
  color: #fb8c00;
  background-color: #fff3e0;
}
.status-active {
  color: #1e88e5;
  background-color: #e6f0ff;
}
.status-ended {
  color: #999999;
  background-color: #f0f0f0;
}

/* 标题 */
.detail-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  line-height: 1.4;
  word-break: break-all;
}

/* 正文 */
.detail-content {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.7;
  margin-top: 20rpx;
  word-break: break-all;
}

/* 标签组 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.tag {
  font-size: 24rpx;
  color: #07c160;
  background-color: #e8f8ec;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 发起人 / 热度信息卡 */
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}
.meta-row + .meta-row {
  border-top: 1rpx solid #f2f2f2;
}
.meta-label {
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
  flex-shrink: 0;
  white-space: nowrap;
}
.meta-value {
  font-size: 28rpx;
  color: var(--color-title, #1A1A1A);
  margin-left: 20rpx;
  word-break: break-all;
}
.heat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b35;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 提示文案 */
.tips {
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
  line-height: 1.5;
  padding: 0 10rpx;
}

/* ================= 发布者名片（简历 / 满意度 / 最近评价） ================= */

/* 标题行：左边标题，右边满意度徐章 */
.author-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.author-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  flex-shrink: 0;
  white-space: nowrap;
}

/* 好评率：绿色小徐章；不足 3 条时为灰色「满意度统计中...」 */
.author-rate {
  font-size: 24rpx;
  font-weight: bold;
  color: #07c160;
  background-color: #e8f8ec;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.author-rate-pending {
  color: var(--color-sub, #8A8A8A);
  background-color: #f5f6f8;
  font-weight: normal;
}

/* 头像 + 昵称 */
.author-header {
  display: flex;
  align-items: center;
}

/* 纯文字圆形头像：不依赖外链图片，也不会因图片 404 变破图 */
.author-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #e8f8ec;
  color: #07c160;
  font-size: 38rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  word-break: break-all;
}

.author-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-sub, #8A8A8A);
  line-height: 1.4;
}

/* 小标题：技能描述 / 最近评价 */
.block-label {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--color-sub, #8A8A8A);
  margin-bottom: 12rpx;
}

/* 简历块：整块可点（展开 / 收起），点击热区大一点 */
.resume-block {
  margin-top: 28rpx;
  padding: 20rpx;
  background-color: #f9fafb;
  border-radius: 12rpx;
}

.resume-text {
  font-size: 27rpx;
  color: #444444;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap; /* 保留用户自己换行，但不折行溢出 */
}

/* 默认最多 3 行，超出省略号；展开后取消限制 */
.resume-collapsed {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.resume-toggle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1e88e5;
  text-align: right;
}

.resume-empty {
  font-size: 26rpx;
  color: #b0b0b0;
  line-height: 1.6;
}

/* 发帖人本人视角：引导去完善简历 */
.resume-owner-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b26a00;
  line-height: 1.5;
}

/* 最近评价 */
.author-review-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f2f2;
}

.author-review-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.author-review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.author-review-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.author-review-from {
  font-size: 24rpx;
  color: #666666;
  font-weight: bold;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 满意 / 不满意：颜色区分，一眼能分辨 */
.author-review-badge {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.badge-good {
  color: #07c160;
  background-color: #e8f8ec;
}

.badge-bad {
  color: #e53935;
  background-color: #fdeceb;
}

.author-review-time {
  margin-left: auto;
  padding-left: 16rpx;
  font-size: 22rpx;
  color: #bbbbbb;
  flex-shrink: 0;
  white-space: nowrap;
}

.author-review-content {
  font-size: 27rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}

.author-review-empty {
  font-size: 24rpx;
  color: #b0b0b0;
  padding: 8rpx 0 4rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

/* 举报：浅灰小字，不抢主按钮视觉 */
.report-btn {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 24rpx;
  color: #b0b0b0;
  padding: 0 24rpx 0 4rpx;
}

/* 发帖人的「结束」：保持小字低存在感，但比举报略深一点，表示可操作 */
.report-btn-owner {
  color: #8a8a8a;
}

/* 已结束：置灰且不可点（没有绑定任何事件） */
.report-btn-disabled {
  color: #d0d0d0;
}

.action-btn {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-btn, 12rpx); /* 全站按钮圆角标准 */
  padding: 0;
}
.btn-apply {
  background-color: #07c160;
  color: #ffffff;
}
.btn-owner {
  background-color: #1e88e5;
  color: #ffffff;
}
.btn-applied {
  background-color: #f0f0f0;
  color: #999999;
}
/* 已结束：主按钮置灰不可点 */
.btn-ended {
  background-color: #f0f0f0 !important;
  color: #bbbbbb !important;
}
.action-btn[disabled] {
  background-color: #f0f0f0 !important;
  color: #bbbbbb !important;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 70vh;
  color: #999999;
}
.icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}
.text {
  font-size: 32rpx;
  color: var(--color-title, #1A1A1A);
  font-weight: bold;
}
.sub-text {
  font-size: 26rpx;
  margin-top: 10rpx;
  color: var(--color-sub, #8A8A8A);
}
