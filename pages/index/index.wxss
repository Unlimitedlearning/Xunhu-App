/*pages\index\index.wxss */
page {
  height: 100vh;
  background-color: #f5f6f8; /* 浅灰背景，降低视觉噪点 */
}

/* 大厅整体：固定 Tab 栏 + 下方滚动列表（纵向 flex） */
.hall {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ---------- 顶部 Tab（最新发布 / 最热招募 / 往期历史） ---------- */
.tab-bar {
  flex-shrink: 0;
  height: 96rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #f5f6f8; /* 与页面底色一致，只靠选中态的白色胶囊分层 */
}

.tab-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--color-sub, #8A8A8A);
  border-radius: 12rpx;
  white-space: nowrap;
  transition: background-color 0.15s ease, color 0.15s ease;
}

/* 选中态：白底胶囊 + 微信绿 + 加粗，一眼能看出当前在哪个 Tab */
.tab-item-active {
  background-color: #ffffff;
  color: #07c160;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ---------- 热门标签栏（三个 Tab 下方，可横向滑动） ---------- */
.tag-bar {
  flex-shrink: 0;
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  white-space: nowrap;      /* 配合 inline-block 实现横向滑动 */
  background-color: #f5f6f8; /* 与页面底色一致，只靠胶囊分层 */
}

/* 单个标签胶囊：浅灰背景 + 小字号 */
.hot-tag {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #666666;
  background-color: #f0f0f0;
  border-radius: 28rpx;
  vertical-align: top;
  white-space: nowrap;
  transition: background-color 0.15s ease, color 0.15s ease;
}

/* 选中态：微信绿高亮（与 Tab 选中态同一套颜色语言） */
.hot-tag-active {
  color: #ffffff;
  background-color: #07c160;
  font-weight: bold;
}

.scrollarea {
  /* 占满视口剩余高度（100vh 已扣除导航栏与 tabBar，再扣掉 96rpx 的 Tab 栏） */
  height: calc(100vh - 96rpx);
  box-sizing: border-box;
}

/* 热门标签栏出现时，列表区再让出 80rpx（否则会被挤出可视区） */
.scrollarea-with-tags {
  height: calc(100vh - 176rpx);
}

.container {
  padding: 20rpx;
  padding-bottom: 250rpx; /* 保证最后一张卡片能完整滑到悬浮按钮上方 */
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 卡片之间的间距 */
}

/* 列表容器：卡片之间统一 20rpx 间距（与骨架屏保持一致） */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 卡片整体样式：纯白 + 大圆角 + 极浅阴影（全站统一标准） */
.post-card {
  position: relative;
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
}

/* 描述：与标题同层级颜色（#1A1A1A，不死黑），靠字号/字重拉开层次 */
.post-desc {
  font-size: 28rpx;
  color: var(--color-title, #1A1A1A);
  margin-top: 16rpx;
  line-height: 1.6;
  /* 超过两行省略号 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 审核中的掩码文案：降低存在感，不吸引点开 */
.post-desc-mask {
  color: #c8c9cc;
  letter-spacing: 4rpx;
}

/* 标签组 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 单个标签的样式 */
.tag {
  font-size: 24rpx;
  color: #07c160; /* 微信绿 */
  background-color: #e8f8ec;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.post-header {
  display: flex;
  align-items: flex-start; /* 顶部对齐，防止高度拉扯 */
  margin-bottom: 20rpx;
}

.category-tag {
  font-size: 28rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  font-weight: bold;
  flex-shrink: 0;      /* 防挤压：不被标题压变形 */
  white-space: nowrap; /* 防挤压：不换行 */
  height: 32rpx;        /* 给死高度 */
  line-height: 32rpx;   /* 和高度一致，文字绝对居中 */
  text-align: center;
}
/* 组队-蓝色 */
.category-team {
  background-color: #e6f0ff;
  color: #1e88e5;
}
/* 自荐-绿色 */
.category-resume {
  background-color: #e8f8ec;
  color: #07c160;
}
/* 搭子-橙色 */
.category-partner {
  background-color: #fff3e0;
  color: #fb8c00;
}
/* 未知分类兜底 */
.category-other {
  background-color: #f0f0f0;
  color: #999999;
}

.post-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  flex: 1;
  min-width: 0;         /* 允许标题收缩，配合标签 flex-shrink: 0 */
  line-height: 40rpx;   /* 给标题一个行高 */
  word-break: break-all;
}

/* 状态标识（卡片右上角：草稿 / 审核中 / 已结束 / 寻呼中） */
.status-badge {
  flex-shrink: 0;      /* 防挤压 */
  white-space: nowrap; /* 防挤压 */
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  margin-top: 2rpx;
  font-weight: bold;
}
/* 审核中 - 橙色 */
.status-auditing {
  color: #fb8c00;
  background-color: #fff3e0;
}
/* 已结束 - 灰色 */
.status-ended {
  color: #999999;
  background-color: #f0f0f0;
}
/* 草稿（上传失败的本地数据） - 红色 */
.status-draft {
  color: #e53935;
  background-color: #ffebee;
}
/* 寻呼中（正常在线） - 绿色 */
.status-active {
  color: #07c160;
  background-color: #e8f8ec;
}

/* 底部区域 */
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eeeeee;
}

.author {
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 底部右侧：热度值 + 了解详情 */
.footer-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 热度值 */
.heat {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-right: 20rpx;
}

/* 了解详情按钮（目前只是文字） */
.join-btn {
  font-size: 26rpx;
  color: #ffffff;
  background-color: #07c160;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-btn, 12rpx); /* 全站按钮圆角标准 */
  flex-shrink: 0;
  white-space: nowrap;
}

/* ---------- 首次加载提示（云数据一次来回，不再用骨架屏） ---------- */
.loading-text {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
  padding: 60rpx 0;
}

/* ---------- 空状态：极简灰色提示卡片 ---------- */
.empty-card {
  background-color: #fafbfc;
  border: 1rpx solid #ededed;
  border-radius: var(--radius-card, 24rpx);
  padding: 72rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
  line-height: 1.7;
  text-align: center;
}

/* ---------- 固定悬浮「发布」按钮 ----------
   已放弃 movable-area / movable-view 拖动方案：
   1) 不再有覆盖整屏的拖拽层，列表滑动、TabBar 点击都不受影响；
   2) 元素只占据自身 100rpx 圆形范围，命中区域即按钮本身；
   3) position: fixed 相对页面可视区定位，原生 tabBar 在可视区之外，天然不会遮挡。 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #07c160;
  color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  z-index: 10; /* 仅需盖住卡片内容，不与原生 tabBar 竞争层级 */
  transition: transform 0.1s ease, opacity 0.1s ease;
}

/* 点击反馈：轻微缩放代替拖动位移 */
.fab-btn-hover {
  transform: scale(0.94);
  opacity: 0.9;
}

.fab-icon {
  font-size: 60rpx;
  line-height: 1;
  /* 视觉微调：让 + 号在圆形里看着居中 */
  transform: translateY(-2rpx);
}

/* ---------- 新生一次性使用引导（首次进大厅） ----------
   半透明遮罩 + 居中纯白卡片；重点说清「与普通微信群的区别」：
   学号校验 / 双向互评信用 / 联系方同意才展示 / 一键发起。 */
.guide-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999; /* 高于 fab-btn(10)，引导期间不会误点发布 */
  background-color: rgba(0, 0, 0, 0.55); /* 半透明遮罩 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.guide-card {
  width: 100%;
  max-width: 620rpx;
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
}

.guide-title {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.4;
  color: var(--color-title, #1A1A1A);
  text-align: center;
}

.guide-intro {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-sub, #8A8A8A);
  text-align: center;
}

/* 卖点行：emoji 作 bullet，右侧标题加粗 + 短句说明 */
.guide-item {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
}

.guide-emoji {
  flex-shrink: 0;
  width: 44rpx;
  font-size: 32rpx;
  line-height: 44rpx;
}

.guide-item-body {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #444444;
}

.guide-item-title {
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
}

.guide-item-desc {
  color: #555555;
}

/* 底部主按钮：微信绿胶囊，覆盖 button 默认边框 */
.guide-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 44rpx;
  padding: 0;
  border-radius: 44rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.guide-btn::after {
  border: none;
}
