/*pages\index\index.wxss */
page {
  height: 100vh;
  background-color: #f5f5f5; /* 背景颜色 */
}

.scrollarea {
  /* 使用 calc 计算高度，减去底部导航栏和悬浮按钮的空间 */
  height: calc(100vh - 150rpx);
}

.container {
  padding: 20rpx;
  padding-bottom: 200rpx; /* 给底部留出足够的安全距离 */
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 卡片之间的间距 */
}

/* 卡片整体样式 */
.post-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); /* 微微的阴影 */
}

/* 描述 */
.post-desc {
  font-size: 28rpx;
  color: #666666;
  margin-top: 12rpx;
  line-height: 1.5;
  /* 超过两行省略号 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 标签组 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 单个标签的样式 */
.tag {
  font-size: 24rpx;
  color: #07c160; /* 微信绿 */
  background-color: #e8f8ec;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.post-header {
  display: flex;
  align-items: flex-start; /* 顶部对齐，防止高度拉扯 */
  margin-bottom: 12rpx;
}

.category-tag {
  font-size: 28rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  font-weight: bold;
  flex-shrink: 0;      /* 防挤压：不被标题压变形 */
  white-space: nowrap; /* 防挤压：不换行 */
  height: 32rpx;        /* 给死高度 */
  line-height: 32rpx;   /* 和高度一致，文字绝对居中 */
  text-align: center;
}
/* 组队-蓝色 */
.category-team {
  background-color: #e6f0ff;
  color: #1e88e5;
}
/* 自荐-绿色 */
.category-resume {
  background-color: #e8f8ec;
  color: #07c160;
}
/* 搭子-橙色 */
.category-partner {
  background-color: #fff3e0;
  color: #fb8c00;
}
/* 未知分类兜底 */
.category-other {
  background-color: #f0f0f0;
  color: #999999;
}

.post-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  min-width: 0;         /* 允许标题收缩，配合标签 flex-shrink: 0 */
  line-height: 40rpx;   /* 给标题一个行高 */
  word-break: break-all;
}

/* 状态标识（卡片右上角：审核中 / 已结束 / 待同步） */
.status-badge {
  flex-shrink: 0;      /* 防挤压 */
  white-space: nowrap; /* 防挤压 */
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  margin-top: 2rpx;
  font-weight: bold;
}
/* 审核中 - 橙色 */
.status-auditing {
  color: #fb8c00;
  background-color: #fff3e0;
}
/* 已结束 - 灰色 */
.status-ended {
  color: #999999;
  background-color: #f0f0f0;
}
/* 待同步（本地草稿） - 红色 */
.status-draft {
  color: #e53935;
  background-color: #ffebee;
}

/* 底部区域 */
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eeeeee;
}

.author {
  font-size: 24rpx;
  color: #999999;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 底部右侧：热度值 + 了解详情 */
.footer-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 热度值 */
.heat {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-right: 20rpx;
}

/* 了解详情按钮（目前只是文字） */
.join-btn {
  font-size: 26rpx;
  color: #ffffff;
  background-color: #07c160;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 拖拽区域 */
.movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none; /* 关键：让透明区域不阻挡下方列表的滑动 */
  z-index: 99;
}

/* 按钮本身 */
.fab-btn {
  pointer-events: auto; /* 关键：按钮本身可以被点击和拖拽 */
  position: absolute;
  bottom: 120rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}
