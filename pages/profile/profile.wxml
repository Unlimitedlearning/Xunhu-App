<!--pages/profile/profile.wxml-->
<view class="page">

  <!-- 未登录：只显示登录入口 -->
  <view class="login-card" wx:if="{{!isLogin}}">
    <view class="avatar avatar-guest">?</view>
    <view class="login-text">登录后可维护简历、查看收到的评价</view>
    <button class="login-btn" bindtap="handleLogin">点击登录</button>
  </view>

  <!-- 已登录 -->
  <block wx:else>

    <!-- 个人信息：昵称/学号/头像全部来自你自己填的资料，不再有内置演示身份 -->
    <view class="card">
      <view class="profile-header">
        <view class="avatar">{{avatarText}}</view>
        <view class="profile-info">
          <view class="name">{{nickname ? nickname : '未设置昵称'}}</view>
          <view class="student-id" wx:if="{{campus}}">校区：{{campus}}</view>
          <view class="student-id" wx:if="{{studentId}}">学号：{{studentId}}</view>
          <view class="student-id" wx:else>学号：未填写</view>
        </view>
      </view>

      <!-- 账号信用状态：warningCount 来自云端 users（只读），0 次绿色「信用良好」，>= 1 次橙红警告 -->
      <view class="credit-row">
        <text class="credit-label">账号信用状态</text>
        <text class="credit-value {{creditGood ? 'credit-good' : 'credit-warn'}}">{{creditText}}</text>
      </view>
    </view>

    <!-- 资料未完善：先提示，避免发布/申请时找不到展示名或联系方式 -->
    <view class="notice-card" wx:if="{{!isProfileReady}}">
      昵称、校区、学号与联系方式都填好并保存后，才能在大厅发布需求、申请他人需求（否则队友无法联系您）。
    </view>

    <!-- 简历引导：这份描述会公开在详情页，写清楚才有人敢点「申请加入」 -->
    <view class="resume-banner" wx:if="{{!resume}}">
      <view class="resume-banner-title">✏️ 补一句简历 / 技能描述，更容易被选中</view>
      <view class="resume-banner-text">你填写的这部分内容会以「发布者名片」形式，在详情页向所有同学公开展示（默认显示 3 行，可点击展开），并配上你收到的匿名评价与满意度，帮同学判断要不要与你合作。</view>
      <view class="resume-banner-action">在下方「简历 / 技能描述」里写完，点保存资料即可生效</view>
    </view>

    <!-- 资料编辑：昵称 / 学号 / 简历 / 联系方式 -->
    <view class="card">
      <view class="section-title">昵称<text class="required">*</text></view>
      <input class="text-input"
             placeholder="填一个同学们能认出你的名字"
             maxlength="20"
             value="{{nickname}}"
             bindinput="onNicknameInput" />
      <!-- 昵称唯一性引导（v1.8.0）：昵称重名会导致冒充，这里提前告知用户规则 -->
      <text class="tip">建议使用独一无二的昵称，以便同学记住你。</text>

      <!-- 校区（v1.6.0）：只能从固定选项里选，用于展示与匹配，不涉及任何身份认证 -->
      <view class="section-title section-title-gap">校区<text class="required">*</text><text class="badge-private">用于展示与匹配</text></view>
      <picker mode="selector"
              range="{{campusOptions}}"
              value="{{campusIndex}}"
              bindchange="onCampusChange">
        <view class="text-input picker-input {{campus ? '' : 'picker-placeholder'}}">{{campus ? campus : '请选择你所在的校区'}}</view>
      </picker>
      <text class="tip">{{campusTip}}</text>

      <view class="section-title section-title-gap">学号<text class="required">*</text></view>
      <input class="text-input {{isStudentIdBound ? 'text-input-locked' : ''}}"
             type="number"
             disabled="{{isStudentIdBound}}"
             placeholder="广工学号"
             maxlength="10"
             value="{{studentId}}"
             bindinput="onStudentIdInput" />

      <!-- 已绑定：输入框锁死，右侧只留一个极小的申诉入口 -->
      <view class="student-bound-row" wx:if="{{isStudentIdBound}}">
        <text class="tip tip-inline">已绑定，不可修改</text>
        <text class="link-mini" catchtap="onStudentIdOccupied">学号被他人占用？</text>
      </view>
      <text class="tip" wx:else>{{studentIdTip}}</text>

      <view class="section-title section-title-gap">简历 / 技能描述<text class="badge-public">详情页公开展示</text></view>
      <textarea class="resume-input"
                placeholder="介绍一下你的技能、项目经历（会公开展示在详情页「发布者名片」，默认只显示 3 行预览）"
                maxlength="300"
                value="{{resume}}"
                bindinput="onResumeInput"></textarea>
      <text class="tip" wx:if="{{resume}}">✓ 已公开在详情页「发布者名片」中展示</text>
      <text class="tip" wx:else>这段描述会公开展示给所有浏览你帖子的同学；联系方式与学号不会公开</text>

      <view class="section-title section-title-gap">联系方式<text class="required">*</text></view>
      <input class="contact-input"
             placeholder="微信号 / QQ / 手机号"
             maxlength="40"
             value="{{contact}}"
             bindinput="onContactInput" />

      <text class="tip">联系方式仅在你同意申请后展示给申请人</text>

      <!-- 【防连点】保存中：按钮置灰 + loading，请求结束（成功或失败）后由 saveProfile 恢复 -->
      <button class="save-btn"
              disabled="{{isSaving}}"
              loading="{{isSaving}}"
              bindtap="saveProfile">保存资料</button>
    </view>

    <!-- 收到的评价：来自云端 reviews 集合（我作为被评价人），评价人一律匿名「某同学」 -->
    <view class="card">
      <view class="review-header">
        <view class="section-title">收到的评价</view>
        <!-- 好评率 + 评价次数同句展示：满 3 条「好评率 95%（共 20 条评价）」，不足时「满意度统计中...（2/3 条）」 -->
        <view class="review-rate {{showReviewRate ? '' : 'review-rate-pending'}}">{{reviewRateText}}</view>
      </view>
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-head">
          <text class="review-from">{{item.fromName}}</text>
          <text class="review-time">{{item.createTime}}</text>
        </view>
        <!-- 满意度、评价状态、合作上下文：一行排开，空间不够时只截上下文 -->
        <view class="review-meta">
          <view class="review-badge {{item.isGood ? 'review-badge-good' : 'review-badge-bad'}}">{{item.ratingText}}</view>
          <!-- 合作上下文快照：服务端写入时定死的「【组队-某项目】」，老数据无此字段时整块不渲染 -->
          <view class="review-context" wx:if="{{item.contextSnapshot}}">{{item.contextSnapshot}}</view>
        </view>
        <view class="review-content">{{item.content}}</view>
      </view>
      <view class="empty-review" wx:if="{{reviews.length === 0}}">{{reviewEmptyText}}</view>
    </view>

    <!-- 管理员入口：仅 role === 'admin' 显示（reports / users 禁读，后台所有操作走 admin 云函数） -->
    <view class="admin-entry" wx:if="{{isAdmin}}" hover-class="admin-entry-hover" hover-stay-time="80" bindtap="onAdminTap">
      <view class="admin-entry-left">
        <text class="admin-entry-label">进入管理后台</text>
        <text class="admin-entry-sub">举报审查 / 学号申诉</text>
      </view>
      <text class="admin-entry-arrow">›</text>
    </view>

    <view class="logout-btn" bindtap="handleLogout">退出登录</view>

    <!-- 账号注销（v1.6.0 合规）：二次确认后调 user 云函数 deleteAccount，删除不可恢复 -->
    <view class="delete-account-btn" hover-class="delete-account-hover" hover-stay-time="80" bindtap="handleDeleteAccount">注销账号</view>

  </block>

  <!-- 底部菜单：消息中心（含红点） + 意见反馈与帮助（邮箱是唯一的对外反馈渠道） -->
  <view class="menu-card">
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="80" bindtap="onMessageTap">
      <view class="menu-label-wrap">
        <text class="menu-label">消息中心</text>
        <!-- 红点：有未读个人通知，或最新公告比本地 lastReadMessageTime 新 -->
        <view class="menu-dot" wx:if="{{hasUnreadMessage}}"></view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="80" bindtap="onFeedbackTap">
      <text class="menu-label">意见反馈与帮助</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 信任背书：协议 / 隐私指引入口（未登录也展示；显式绝对路径 + JS 兜底，保证可点击） -->
  <view class="agreement-links">
    <navigator class="agreement-link"
               url="/pages/agreement/agreement"
               open-type="navigate"
               hover-class="agreement-link-hover"
               hover-stay-time="80">
      <text class="agreement-link-text"
            data-path="/pages/agreement/agreement"
            catchtap="onAgreementTap">《用户服务协议》</text>
    </navigator>

    <navigator class="agreement-link"
               url="/pages/agreement/agreement"
               open-type="navigate"
               hover-class="agreement-link-hover"
               hover-stay-time="80">
      <text class="agreement-link-text"
            data-path="/pages/agreement/agreement"
            catchtap="onAgreementTap">《隐私保护指引》</text>
    </navigator>
  </view>

</view>
