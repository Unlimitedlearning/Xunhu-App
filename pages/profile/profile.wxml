<!--pages/profile/profile.wxml-->
<view class="page">

  <!-- 未登录：只显示登录入口 -->
  <view class="login-card" wx:if="{{!isLogin}}">
    <view class="avatar avatar-guest">?</view>
    <view class="login-text">登录后可维护简历、查看收到的评价</view>
    <button class="login-btn" bindtap="handleLogin">点击登录</button>
  </view>

  <!-- 已登录 -->
  <block wx:else>

    <!-- 个人信息：昵称/学号/头像全部来自你自己填的资料，不再有内置演示身份 -->
    <view class="card">
      <view class="profile-header">
        <view class="avatar">{{avatarText}}</view>
        <view class="profile-info">
          <view class="name">{{nickname ? nickname : '未设置昵称'}}</view>
          <view class="student-id" wx:if="{{studentId}}">学号：{{studentId}}</view>
          <view class="student-id" wx:else>学号：未填写</view>
        </view>
      </view>
    </view>

    <!-- 资料未完善：先提示，避免发布/申请时找不到展示名或联系方式 -->
    <view class="notice-card" wx:if="{{!isProfileReady}}">
      昵称、学号与联系方式都填好并保存后，才能在大厅发布需求、申请他人需求（否则队友无法联系您）。
    </view>

    <!-- 资料编辑：昵称 / 学号 / 简历 / 联系方式 -->
    <view class="card">
      <view class="section-title">昵称<text class="required">*</text></view>
      <input class="text-input"
             placeholder="填一个同学们能认出你的名字"
             maxlength="20"
             value="{{nickname}}"
             bindinput="onNicknameInput" />

      <view class="section-title section-title-gap">学号<text class="required">*</text></view>
      <input class="text-input {{isStudentIdBound ? 'text-input-locked' : ''}}"
             type="number"
             disabled="{{isStudentIdBound}}"
             placeholder="广工 10 位学号（31 开头）"
             maxlength="10"
             value="{{studentId}}"
             bindinput="onStudentIdInput" />

      <!-- 已绑定：输入框锁死，右侧只留一个极小的申诉入口 -->
      <view class="student-bound-row" wx:if="{{isStudentIdBound}}">
        <text class="tip tip-inline">已绑定，不可修改</text>
        <text class="link-mini" catchtap="onStudentIdOccupied">学号被他人占用？</text>
      </view>
      <text class="tip" wx:else>用于本校学生身份认证，一个学号仅能绑定一个微信账号</text>

      <view class="section-title section-title-gap">简历 / 技能描述</view>
      <textarea class="resume-input"
                placeholder="介绍一下你的技能、项目经历，让同学更快认识你"
                maxlength="300"
                value="{{resume}}"
                bindinput="onResumeInput"></textarea>

      <view class="section-title section-title-gap">联系方式<text class="required">*</text></view>
      <input class="contact-input"
             placeholder="微信号 / QQ / 手机号"
             maxlength="40"
             value="{{contact}}"
             bindinput="onContactInput" />

      <text class="tip">联系方式仅在你同意申请后展示给申请人</text>

      <button class="save-btn" bindtap="saveProfile">保存资料</button>
    </view>

    <!-- 收到的评价：来自云端 reviews 集合（我作为被评价人），评价人一律匿名「某同学」 -->
    <view class="card">
      <view class="review-header">
        <view class="section-title">收到的评价</view>
        <!-- 总数 < 3：满意度统计中...；>= 3：好评率 xx% -->
        <view class="review-rate" wx:if="{{showReviewRate}}">好评率 {{reviewRate}}%</view>
        <view class="review-rate review-rate-pending" wx:else>{{reviewPendingText}}</view>
      </view>
      <view class="review-summary" wx:if="{{showReviewRate}}">
        共 {{reviewTotal}} 条评价 · 满意 {{reviewGoodCount}} 条
      </view>
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-head">
          <text class="review-from">{{item.fromName}}</text>
          <text class="review-time">{{item.createTime}}</text>
        </view>
        <view class="review-badge {{item.isGood ? 'review-badge-good' : 'review-badge-bad'}}">{{item.ratingText}}</view>
        <view class="review-content">{{item.content}}</view>
      </view>
      <view class="empty-review" wx:if="{{reviews.length === 0}}">{{reviewEmptyText}}</view>
    </view>

    <view class="logout-btn" bindtap="handleLogout">退出登录</view>

  </block>

  <!-- 底部菜单：意见反馈与帮助（未登录也可见，邮箱是唯一的对外反馈渠道） -->
  <view class="menu-card">
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="80" bindtap="onFeedbackTap">
      <text class="menu-label">意见反馈与帮助</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 信任背书：协议 / 隐私指引入口（未登录也展示；显式绝对路径 + JS 兜底，保证可点击） -->
  <view class="agreement-links">
    <navigator class="agreement-link"
               url="/pages/agreement/agreement"
               open-type="navigate"
               hover-class="agreement-link-hover"
               hover-stay-time="80">
      <text class="agreement-link-text"
            data-path="/pages/agreement/agreement"
            catchtap="onAgreementTap">《用户服务协议》</text>
    </navigator>

    <navigator class="agreement-link"
               url="/pages/agreement/agreement"
               open-type="navigate"
               hover-class="agreement-link-hover"
               hover-stay-time="80">
      <text class="agreement-link-text"
            data-path="/pages/agreement/agreement"
            catchtap="onAgreementTap">《隐私保护指引》</text>
    </navigator>
  </view>

</view>
