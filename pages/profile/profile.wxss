/* pages/profile/profile.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 40rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #eee;
  margin-right: 30rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.student-id {
  font-size: 26rpx;
  color: #999;
}

.menu {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}

.menu-item {
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #333;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}