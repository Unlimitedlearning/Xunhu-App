/* pages/profile/profile.wxss */
page {
  background-color: #f5f6f8;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 通用卡片：与大厅视觉保持一致 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

/* ---------- 未登录 ---------- */
.login-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.login-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
}

.login-btn {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: #07c160;
  border-radius: 40rpx;
  padding: 0;
}

/* 头像：纯文字圆形头像，不依赖外链图片 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #e8f8ec;
  color: #07c160;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-guest {
  background-color: #f0f0f0;
  color: #bbbbbb;
}

/* ---------- 个人资料 ---------- */
.profile-header {
  display: flex;
  align-items: center;
}

.profile-info {
  margin-left: 28rpx;
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.student-id {
  font-size: 26rpx;
  color: #999999;
}

/* ---------- 可编辑资料 ---------- */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-title-gap {
  margin-top: 32rpx;
}

.resume-input {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.contact-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.tip {
  display: block;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 12rpx;
  line-height: 1.5;
}

.save-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #07c160;
  background-color: #e8f8ec;
  border-radius: 40rpx;
  padding: 0;
}

/* ---------- 收到的评价 ---------- */
.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.review-from {
  font-size: 26rpx;
  color: #666666;
  font-weight: bold;
  flex-shrink: 0;
  white-space: nowrap;
}

.review-time {
  font-size: 22rpx;
  color: #bbbbbb;
  flex-shrink: 0;
  white-space: nowrap;
}

.review-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}

.empty-review {
  font-size: 26rpx;
  color: #bbbbbb;
  padding: 20rpx 0;
}

/* ---------- 退出登录 ---------- */
.logout-btn {
  margin-top: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  padding: 24rpx 0;
}
