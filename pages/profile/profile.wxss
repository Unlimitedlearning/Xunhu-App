/* pages/profile/profile.wxss */
page {
  background-color: #f5f6f8;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 80rpx; /* 给底部协议入口留出安全距离，避免贴住 tabBar 边缘 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 通用卡片：与大厅视觉保持一致 */
.card {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
}

/* ---------- 未登录 ---------- */
.login-card {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 60rpx 32rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.login-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
}

.login-btn {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: #07c160;
  border-radius: var(--radius-btn, 12rpx); /* 全站按钮圆角标准 */
  padding: 0;
}

/* 头像：纯文字圆形头像，不依赖外链图片 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #e8f8ec;
  color: #07c160;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-guest {
  background-color: #f0f0f0;
  color: #bbbbbb;
}

/* ---------- 个人资料 ---------- */
.profile-header {
  display: flex;
  align-items: center;
}

.profile-info {
  margin-left: 28rpx;
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  margin-bottom: 10rpx;
}

.student-id {
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
}

/* ---------- 可编辑资料 ---------- */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  margin-bottom: 16rpx;
}

.section-title-gap {
  margin-top: 32rpx;
}

/* 必填星号 */
.required {
  color: #e53935;
  font-size: 26rpx;
  margin-left: 6rpx;
}

.resume-input {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.contact-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

/* 昵称 / 学号等单行输入（复用联系方式输入框的视觉） */
.text-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

/* 学号已绑定：输入框置灰锁死 */
.text-input-locked {
  color: #b0b0b0;
  background-color: #f0f1f3;
}

/* 已绑定行：左侧提示 + 右侧极小申诉入口 */
.student-bound-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.tip-inline {
  margin-top: 0;
}

/* 极小浅灰文字按钮（申诉入口）：点击热区适当放大，避免点不中 */
.link-mini {
  font-size: 20rpx;
  color: #c0c0c0;
  padding: 10rpx 0 10rpx 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
  text-decoration: underline;
}

/* 资料未完善提示条 */
.notice-card {
  background-color: #fff8e6;
  border: 1rpx solid #ffe8b3;
  color: #b26a00;
  border-radius: var(--radius-card, 24rpx);
  padding: 24rpx 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.tip {
  display: block;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 12rpx;
  line-height: 1.5;
}

.save-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #07c160;
  background-color: #e8f8ec;
  border-radius: var(--radius-btn, 12rpx); /* 全站按钮圆角标准 */
  padding: 0;
}

/* ---------- 收到的评价 ---------- */
.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.review-from {
  font-size: 26rpx;
  color: #666666;
  font-weight: bold;
  flex-shrink: 0;
  white-space: nowrap;
}

.review-time {
  font-size: 22rpx;
  color: #bbbbbb;
  flex-shrink: 0;
  white-space: nowrap;
}

.review-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}

.empty-review {
  font-size: 26rpx;
  color: #bbbbbb;
  padding: 20rpx 0;
}

/* ---------- 退出登录 ---------- */
.logout-btn {
  margin-top: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
  padding: 24rpx 0;
}

/* ---------- 底部协议入口（信任背书） ---------- */
.agreement-links {
  position: relative;   /* 建立层叠上下文 */
  z-index: 20;          /* 保证在退出登录等元素之上，不会被遮住点击 */
  margin-top: auto;     /* 页面 flex 纵向布局 + min-height:100vh，把协议入口顶到最底部 */
  padding: 32rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

/* 链接：加大点击热区（高 64rpx），避免“点不动” */
.agreement-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #b0b0b0;
  line-height: 1.6;
}

.agreement-link-text {
  color: #b0b0b0;
  font-size: 24rpx;
}

.agreement-link-hover {
  opacity: 0.6;
}
