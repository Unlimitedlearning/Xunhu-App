/* pages/publish/publish.wxss */
.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box; /* 防止 padding 把宽度撑破 */
  display: flex;
  flex-direction: column;
}

.form-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 标签行：左标题 + 右字数统计 */
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* label 在 .label-row 里时由父级控制间距，避免双倍留白 */
.label-row .label {
  margin-bottom: 0;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 必填星号 */
.required {
  color: #e53935;
  margin-left: 6rpx;
}

/* 字数统计 */
.counter {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 输入框统一约束 */
.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #e5e5e5;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  color: #333333;
}

.input {
  height: 80rpx;
  line-height: 80rpx; /* 文字垂直居中 */
}

.textarea {
  height: 240rpx;
  padding: 20rpx; /* 多行文本需要上下边距 */
  line-height: 1.5;
}

/* 输入框下方的说明文字 */
.tip {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
  line-height: 1.4;
}

.picker-box {
  border: 2rpx solid #e5e5e5;
  padding: 0 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  font-size: 20rpx;
  color: #999;
  flex-shrink: 0;
  white-space: nowrap;
}

.submit-btn {
  margin-top: 20rpx;
  background-color: #07c160 !important;
  border-radius: 50rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.2);
}
