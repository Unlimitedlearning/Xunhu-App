/* pages/publish/publish.wxss */
.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box; /* 防止 padding 把宽度撑破 */
  display: flex;
  flex-direction: column;
}

.form-group {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 30rpx;
  margin-bottom: 30rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
}

/* 标签行：左标题 + 右字数统计 */
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  margin-bottom: 20rpx;
}

/* label 在 .label-row 里时由父级控制间距，避免双倍留白 */
.label-row .label {
  margin-bottom: 0;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 必填星号 */
.required {
  color: #e53935;
  margin-left: 6rpx;
}

/* 字数统计 */
.counter {
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
  flex-shrink: 0;
  white-space: nowrap;
}

/* 输入框统一约束 */
.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #e5e5e5;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  color: var(--color-title, #1A1A1A);
  transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
}

.input {
  height: 80rpx;
  line-height: 80rpx; /* 文字垂直居中 */
}

.textarea {
  height: 240rpx;
  padding: 20rpx; /* 多行文本需要上下边距 */
  line-height: 1.5;
}

/* 聚焦态：边框变微信绿 + 极淡绿光晕，明确告诉用户"正在这里输入" */
.input.field-focus,
.textarea.field-focus {
  border-color: #07c160;
  background-color: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.10);
}

/* 输入框下方的说明文字 */
.tip {
  display: block;
  font-size: 22rpx;
  color: var(--color-sub, #8A8A8A);
  margin-top: 12rpx;
  line-height: 1.4;
}

.picker-box {
  border: 2rpx solid #e5e5e5;
  padding: 0 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  color: var(--color-title, #1A1A1A);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  font-size: 20rpx;
  color: var(--color-sub, #8A8A8A);
  flex-shrink: 0;
  white-space: nowrap;
}

.submit-btn {
  margin-top: 20rpx;
  background-color: #07c160 !important;
  border-radius: var(--radius-btn, 12rpx); /* 全站按钮圆角标准 */
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.2);
}
