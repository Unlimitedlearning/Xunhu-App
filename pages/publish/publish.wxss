/* pages/publish/publish.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box; /* 防止 padding 把宽度撑破 */
  display: flex;
  flex-direction: column;
}

.form-group {
  background-color: #ffffff;
  border-radius: 16rpx; /* 稍微圆润一点 */
  padding: 30rpx;
  margin-bottom: 30rpx;
  width: 100%; /* 强制占满宽度 */
  box-sizing: border-box;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 给输入框加上统一的宽度和高度约束 */
.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #e5e5e5;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fafafa;
}
/* 单独给单行输入框设定高度和行高 */
.input {
  height: 80rpx;       /* 给一个固定的高度 */
  line-height: 80rpx;  /* 让文字在 80rpx 的高度里绝对垂直居中 */
}

.textarea {
  height: 240rpx; /* 固定高度，不让它乱缩 */
  padding: 20rpx; /* 多行文本需要上下边距 */
}

.submit-btn {
  margin-top: 20rpx;
  background-color: #07c160 !important;
  border-radius: 50rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.2); /* 加一点高级的阴影 */
}