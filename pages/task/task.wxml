<!--pages/task/task.wxml-->
<view class="page-container">

  <!-- 未登录 / 资料未完善：暂时隐藏申请列表，只给一个去完善的入口 -->
  <view class="guard-card" wx:if="{{!ready}}">
    <view class="guard-icon">🔒</view>
    <view class="guard-title">{{guardTitle}}</view>
    <view class="guard-tip">{{guardTip}}</view>
    <button class="guard-btn" bindtap="goProfile">去「我的」完善资料</button>
  </view>

  <block wx:else>

  <!-- DEV_DEBUG：排障条。DEV_DEBUG = false 时自动消失，不影响正式界面 -->
  <view class="dev-banner" wx:if="{{devDebug}}">
    <text class="dev-line" selectable="true">openid：{{devInfo.openid}}</text>
    <text class="dev-line">帖子缓存 {{devInfo.postCount}} 条 · 申请缓存 {{devInfo.appCount}} 条</text>
    <text class="dev-line" wx:if="{{devInfo.postIds}}">帖子 id：{{devInfo.postIds}}</text>
    <text class="dev-line dev-err" wx:if="{{devInfo.appError}}">申请拉取失败：{{devInfo.appError}}</text>
  </view>

  <!-- 顶部 Tab -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === index ? 'tab-active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onTabChange">
      <text>{{item}}</text>
    </view>
  </view>

  <!-- Tab 1：我发出的申请 -->
  <view class="list-wrap" wx:if="{{activeTab === 0}}">
    <view class="app-card" wx:for="{{sentList}}" wx:key="id">
      <view class="card-header" bindtap="goToDetail" data-postid="{{item.postId}}">
        <text class="post-title">{{item.postTitle}}</text>
        <view class="status-badge status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <view class="card-body">
        <text class="info-item">发帖人：{{item.authorName}}</text>
      </view>

      <!-- 已同意：才展示发帖人联系方式（pending / rejected 不渲染） -->
      <view class="contact-box" wx:if="{{item.isAccepted && item.contact}}">
        <view class="contact-line">
          <text class="contact-label">联系方式</text>
          <text class="contact-value">{{item.contact}}</text>
        </view>
      </view>

      <!-- 评价入口：已同意 + 帖子已结束才出现；已评价过的按钮变「更新评价」 -->
      <view class="review-row" wx:if="{{item.canReview}}">
        <text class="review-tag" wx:if="{{item.hasReviewed}}">已评价</text>
        <text class="review-tag review-tag-wait" wx:else>可评价对方</text>
        <button class="mini-btn {{item.hasReviewed ? 'btn-review-done' : 'btn-review'}}"
                data-openid="{{item.revieweeOpenid}}"
                data-name="{{item.revieweeName}}"
                data-postid="{{item.postId}}"
                catchtap="onReviewTap">{{item.reviewBtnText}}</button>
      </view>

      <!-- DEV_DEBUG：按钮为何没出现（DEV_DEBUG = false 时不渲染） -->
      <view class="review-hint" wx:if="{{devDebug && item.reviewHint}}">⚠ 无评价按钮：{{item.reviewHint}}</view>

      <view class="card-footer">
        <text class="tip-text" wx:if="{{item.status === 'pending'}}">发起人还在考虑，耐心等等～</text>
        <text class="tip-text" wx:elif="{{item.status === 'rejected'}}">很遗憾，这次没搭上</text>
        <text class="tip-text" wx:elif="{{item.postEnded}}">该寻呼已结束，可以给对方评价了</text>
        <text class="tip-text" wx:else>申请已通过，快去联系发起人吧</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{sentList.length === 0}}">
      <text class="icon">📤</text>
      <view class="text">你还没有申请过任何项目哦</view>
      <view class="sub-text">去「大厅」看看有没有合适的机会吧</view>
    </view>
  </view>

  <!-- Tab 2：我收到的申请 -->
  <view class="list-wrap" wx:else>
    <view class="app-card" wx:for="{{receivedList}}" wx:key="id">
      <view class="card-header" bindtap="goToDetail" data-postid="{{item.postId}}">
        <text class="post-title">{{item.postTitle}}</text>
        <view class="status-badge status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <view class="card-body">
        <text class="info-item">申请人：{{item.applicantName}}</text>
      </view>

      <!-- 已同意：才展示申请人联系方式与完整学号；pending 阶段绝对不能渲染 -->
      <view class="contact-box" wx:if="{{item.isAccepted}}">
        <view class="contact-line" wx:if="{{item.contact}}">
          <text class="contact-label">申请人联系方式</text>
          <text class="contact-value">{{item.contact}}</text>
        </view>
        <view class="contact-line" wx:if="{{item.studentId}}">
          <text class="contact-label">申请人学号</text>
          <text class="contact-value">{{item.studentId}}</text>
        </view>
      </view>

      <!-- 待处理：提供同意 / 拒绝 -->
      <view class="action-row" wx:if="{{item.isPending}}">
        <button class="mini-btn btn-reject"
                data-id="{{item.id}}"
                data-action="rejected"
                catchtap="handleApplication">拒绝</button>
        <button class="mini-btn btn-accept"
                data-id="{{item.id}}"
                data-action="accepted"
                catchtap="handleApplication">同意</button>
      </view>

      <!-- 评价入口：已同意 + 帖子已结束才出现；已评价过的按钮变「更新评价」 -->
      <view class="review-row" wx:if="{{item.canReview}}">
        <text class="review-tag" wx:if="{{item.hasReviewed}}">已评价</text>
        <text class="review-tag review-tag-wait" wx:else>可评价对方</text>
        <button class="mini-btn {{item.hasReviewed ? 'btn-review-done' : 'btn-review'}}"
                data-openid="{{item.revieweeOpenid}}"
                data-name="{{item.revieweeName}}"
                data-postid="{{item.postId}}"
                catchtap="onReviewTap">{{item.reviewBtnText}}</button>
      </view>

      <!-- DEV_DEBUG：按钮为何没出现（DEV_DEBUG = false 时不渲染） -->
      <view class="review-hint" wx:if="{{devDebug && item.reviewHint}}">⚠ 无评价按钮：{{item.reviewHint}}</view>

      <view class="card-footer" wx:if="{{!item.isPending}}">
        <text class="tip-text" wx:if="{{item.status === 'rejected'}}">你已拒绝该申请</text>
        <text class="tip-text" wx:elif="{{item.postEnded}}">该寻呼已结束，可以给申请人评价了</text>
        <text class="tip-text" wx:else>已同意，可联系申请人进一步沟通</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{receivedList.length === 0}}">
      <text class="icon">📭</text>
      <view class="text">暂时还没有人申请你的项目</view>
      <view class="sub-text">发布一条寻呼，让同学找到你</view>
    </view>
  </view>

  </block>

  <!-- 评价弹窗：单选满意/不满意 + 最多 50 字；有旧评价时自动回填，按钮变「更新评价」 -->
  <view class="review-mask" wx:if="{{reviewModalShow}}"
        catchtouchmove="noop"
        bindtap="closeReviewModal">
    <view class="review-dialog" catchtap="noop">
      <view class="review-dialog-title">{{reviewIsUpdate ? '更新评价' : '评价对方'}}</view>
      <view class="review-dialog-sub">评价对象：{{reviewTarget.name}}</view>

      <!-- 单选：满意 / 不满意（rating 1 / 0） -->
      <view class="review-options">
        <view class="review-option {{reviewRating === 1 ? 'review-option-good' : ''}}"
              data-rating="1"
              bindtap="onReviewRatingTap">👍 满意</view>
        <view class="review-option {{reviewRating === 0 ? 'review-option-bad' : ''}}"
              data-rating="0"
              bindtap="onReviewRatingTap">👎 不满意</view>
      </view>

      <view class="review-textarea-wrap">
        <textarea class="review-textarea"
                  value="{{reviewContent}}"
                  maxlength="{{reviewMaxLength}}"
                  placeholder="说说这次合作的感受（选填）"
                  bindinput="onReviewContentInput"></textarea>
        <text class="review-counter">{{reviewContent.length}}/{{reviewMaxLength}}</text>
      </view>

      <view class="review-dialog-actions">
        <button class="dialog-btn dialog-btn-cancel" catchtap="closeReviewModal">取消</button>
        <button class="dialog-btn dialog-btn-ok"
                loading="{{reviewSubmitting}}"
                disabled="{{reviewSubmitting}}"
                catchtap="submitReview">{{reviewIsUpdate ? '更新评价' : '提交评价'}}</button>
      </view>
    </view>
  </view>

</view>
