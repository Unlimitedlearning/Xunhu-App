/* pages/task/task.wxss */
page {
  background-color: #f5f6f8;
}

.page-container {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 未登录 / 资料未完善：拦截提示卡（替代申请列表） */
.guard-card {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 72rpx 40rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guard-icon {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.guard-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  margin-bottom: 16rpx;
}

.guard-tip {
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 32rpx;
}

.guard-btn {
  width: 360rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: #07c160;
  border-radius: var(--radius-btn, 12rpx);
  padding: 0;
}

/* 顶部 Tab */
.tab-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: var(--radius-btn, 12rpx);
  white-space: nowrap;
  flex-shrink: 0;
}

.tab-active {
  background-color: #07c160;
  color: #ffffff;
  font-weight: bold;
}

/* 申请卡片 */
.app-card {
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.03));
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.post-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  line-height: 1.4;
  word-break: break-all;
}

/* 状态标识：防挤压 */
.status-badge {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.status-pending {
  color: #fb8c00;
  background-color: #fff3e0;
}
.status-accepted {
  color: #07c160;
  background-color: #e8f8ec;
}
.status-rejected {
  color: #999999;
  background-color: #f0f0f0;
}

.card-body {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-item {
  font-size: 26rpx;
  color: var(--color-sub, #8A8A8A);
}

/* 已同意的联系方式 */
.contact-box {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background-color: #e8f8ec;
  border-radius: 12rpx;
}

.contact-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.contact-label {
  font-size: 24rpx;
  color: #07c160;
  flex-shrink: 0;
  white-space: nowrap;
}

.contact-value {
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
  margin-left: 16rpx;
  word-break: break-all;
}

/* 底部提示 */
.card-footer {
  margin-top: 16rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
  line-height: 1.4;
}

/* 同意 / 拒绝按钮 */
.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.mini-btn {
  margin: 0;
  font-size: 26rpx;
  line-height: 64rpx;
  height: 64rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-btn, 12rpx); /* 全站按钮圆角标准 */
  font-weight: bold;
  flex-shrink: 0;
  white-space: nowrap;
}

.btn-accept {
  background-color: #07c160;
  color: #ffffff;
}

.btn-reject {
  background-color: #f7f8fa;
  color: #666666;
  border: 1rpx solid #e5e5e5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 55vh;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 28rpx;
  opacity: 0.45;
}
.text {
  font-size: 30rpx;
  color: var(--color-title, #1A1A1A);
  font-weight: bold;
  text-align: center;
  line-height: 1.5;
}
.sub-text {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: var(--color-sub, #8A8A8A);
  text-align: center;
  line-height: 1.5;
}

/* ---------- 评价入口 ---------- */
.review-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f2f2;
}

.review-tag {
  font-size: 22rpx;
  color: #07c160;
  background-color: #e8f8ec;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.review-tag-wait {
  color: #b26a00;
  background-color: #fff8e6;
}

/* 未评价：淡绿底；已评价：浅灰描边，表示可以点开更新 */
.btn-review {
  background-color: #e8f8ec;
  color: #07c160;
}

.btn-review-done {
  background-color: #f7f8fa;
  color: #666666;
  border: 1rpx solid #e5e5e5;
}

/* ---------- 评价弹窗 ---------- */
.review-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.review-dialog {
  width: 100%;
  max-width: 620rpx;
  background-color: #ffffff;
  border-radius: var(--radius-card, 24rpx);
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.review-dialog-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-title, #1A1A1A);
  text-align: center;
}

.review-dialog-sub {
  font-size: 24rpx;
  color: var(--color-sub, #8A8A8A);
  text-align: center;
  margin-top: 12rpx;
}

/* 单选：满意 / 不满意 */
.review-options {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.review-option {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  background-color: #f7f8fa;
  border: 2rpx solid #eeeeee;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.review-option-good {
  color: #07c160;
  background-color: #e8f8ec;
  border-color: #07c160;
  font-weight: bold;
}

.review-option-bad {
  color: #e53935;
  background-color: #fdeceb;
  border-color: #e53935;
  font-weight: bold;
}

/* 50 字文本框 */
.review-textarea-wrap {
  position: relative;
  margin-top: 28rpx;
}

.review-textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 20rpx 46rpx;
}

.review-counter {
  position: absolute;
  right: 20rpx;
  bottom: 14rpx;
  font-size: 22rpx;
  color: #b0b0b0;
}

.review-dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.dialog-btn {
  flex: 1;
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: var(--radius-btn, 12rpx);
  padding: 0;
}

.dialog-btn-cancel {
  background-color: #f7f8fa;
  color: #666666;
}

.dialog-btn-ok {
  background-color: #07c160;
  color: #ffffff;
}
